---
// The exported lower layers are cut-away strips. Reuse the complete top
// silhouette so moving the layers apart never exposes an unfinished edge.
const layerShape = "M43.5663 84.7448C26.1888 77.7973 17.5 74.3236 17.5 70.0011C17.5 65.6786 26.1888 62.2136 43.5663 55.2573L68.1363 45.4311C85.5138 38.4748 94.2113 35.0011 105 35.0011C115.789 35.0011 124.486 38.4748 141.864 45.4311L166.434 55.2573C183.811 62.2048 192.5 65.6786 192.5 70.0011C192.5 74.3236 183.811 77.7886 166.434 84.7448L141.864 94.5798C124.486 101.527 115.789 105.001 105 105.001C94.2113 105.001 85.5138 101.527 68.1363 94.5798L43.5663 84.7448Z";
---

<div class="feature-card__icon map-motion" data-motion="map" aria-hidden="true">
  <svg
    class="map-motion__svg"
    width="210"
    height="210"
    viewBox="0 0 210 210"
    preserveAspectRatio="none"
    fill="var(--vc-color-purple)"
    xmlns="http://www.w3.org/2000/svg"
    focusable="false"
  >
    <g transform="translate(0 70)">
      <g class="map-motion__layer" data-map-layer="bottom">
        <path d={layerShape} opacity="0.24" />
      </g>
    </g>
    <g transform="translate(0 35)">
      <g class="map-motion__layer" data-map-layer="middle">
        <!-- Match the card beneath this layer so the two translucent fills
             keep their original tones where the complete shapes overlap. -->
        <path d={layerShape} fill="var(--vc-surface-background)" />
        <path d={layerShape} opacity="0.5" />
      </g>
    </g>
    <g class="map-motion__layer" data-map-layer="top">
      <path d={layerShape} />
    </g>
  </svg>
</div>

<style>
  .map-motion__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .map-motion__layer {
    transform-box: view-box;
    transform-origin: 50% 50%;
  }
</style>

<script src="../scripts/map-motion.ts"></script>
